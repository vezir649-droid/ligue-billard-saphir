<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/saphir_blue"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎱 SAPHIR SMS SENTINELLE"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ligue de billard Boule en main — Salle Le Saphir"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Carte Statut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/saphir_card"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 Surveillance arrêtée"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_last_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune vérification effectuée"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Configuration Supabase -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/saphir_card"
        android:padding="14dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration Cloud (Mémorisée en permanence)"
            android:textColor="@color/saphir_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_supabase_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL Supabase (https://...)"
            android:textColor="@color/white"
            android:textColorHint="#777777"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/et_supabase_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Clé API Supabase (anon ou service)"
            android:inputType="textPassword"
            android:textColor="@color/white"
            android:textColorHint="#777777"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/btn_save_config"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="💾 Enregistrer et conserver la configuration"
            android:textColor="@color/white"
            android:backgroundTint="#34495E"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Boutons Action -->
    <Button
        android:id="@+id/btn_toggle_service"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="DÉMARRER LA SURVEILLANCE"
        android:backgroundTint="@color/saphir_accent"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_sync_now"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="⚡ VÉRIFIER ET ENVOYER MAINTENANT"
        android:textColor="@color/white"
        android:backgroundTint="#2E7D32"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_test_sms"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="📲 TESTER UN SMS DE VÉRIFICATION"
        android:textColor="@color/white"
        android:backgroundTint="@color/saphir_dark"
        android:layout_marginBottom="14dp"/>

    <!-- Journal des événements -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Journal d'activité :"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#151E28"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En attente de démarrage..."
            android:textColor="#88FF88"
            android:textSize="11sp"
            android:fontFamily="monospace"/>
    </ScrollView>

</LinearLayout>
